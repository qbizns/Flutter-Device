# Device Bridge v2 - Docker Environment Variables
# Copy this file to .env and configure your settings

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=changeme

# Mada Payment Provider (Saudi Arabia)
MADA_TERMINAL_ID=
MADA_MERCHANT_ID=
MADA_AUTH_KEY=

# KNET Payment Provider (Kuwait)
KNET_TERMINAL_ID=
KNET_MERCHANT_ID=
KNET_AUTH_KEY=

# API Configuration
API_PORT=8080
API_KEY=

# Prometheus Configuration
PROMETHEUS_PORT=9090

# Monitoring Endpoints
JAEGER_ENDPOINT=
LOGSTASH_ENDPOINT=

# Security
ENCRYPTION_KEY_ID=

# Alerting
ALERT_EMAIL=
ALERT_WEBHOOK=
